{
  "name": "kanban-cli",
  "private": true,
  "version": "0.0.1",
  "description": "Command-line tool that sends commands to an open KanbanLight board over a local WebSocket bridge.",
  "main": "dist/index.js",
  "bin": {
    "kb": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": ["kanban", "cli", "websocket", "kanbanlight"],
  "author": "Vardaan Bajaj",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vardaanbazaz/kanbanlight.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/vardaanbazaz/kanbanlight/tree/main/cli#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/ws": "^8.5.8",
    "typescript": "^5.2.2",
    "tsx": "^3.14.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.6",
    "eslint": "^8.51.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4"
  }
}
{
  "name": "kanban-cli",
  "private": true,
  "version": "0.0.2",
  "description": "Command-line tool that sends commands to an open KanbanLight board over a local WebSocket bridge.",
  "main": "dist/index.js",
  "bin": {
    "kb": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "smoke": "node dist/index.js -V",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "kanban",
    "cli",
    "websocket",
    "kanbanlight"
  ],
  "author": "Vardaan Bajaj",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vardaanbazaz/kanbanlight.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/vardaanbazaz/kanbanlight/tree/main/cli#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
